# Never commit a populated copy. Use .env.local or caseflow-api/.env locally.
CASEFLOW_MODE=PUBLIC_REPLAY
CASEFLOW_PUBLIC_BASE_PATH=/caseflow
CASEFLOW_ENABLE_LIVE_READS=false
CASEFLOW_ENABLE_LIVE_WRITES=false
CASEFLOW_ALLOWED_SYNTHETIC_TARGET=caseflow-sandbox
CASEFLOW_EVIDENCE_OUTPUT_DIR=./.caseflow-live-evidence
CASEFLOW_FIXED_CLOCK=2026-07-24T17:30:00Z

# CData Connect AI
CDATA_ACCOUNT_EMAIL=
CDATA_ACCT_EMAIL=
CDATA_PAT=
CDATA_BASE_URL=https://cloud.cdata.com/api
CDATA_QUERY_MCP_URL=https://mcp.cloud.cdata.com/mcp
CDATA_MANAGEMENT_MCP_URL=https://mcp.cloud.cdata.com/mcp/mgmt
CDATA_CRM_CATALOG=CaseFlowCRM
CDATA_OPERATIONS_CATALOG=CaseFlowOperations
CDATA_POLICY_CATALOG=CaseFlowPolicy
CDATA_WORKSPACE=

# Optional LLM synthesis. The deterministic workflow functions without a model.
CASEFLOW_LLM_PROVIDER=none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
CASEFLOW_LLM_MODEL=

# Local API
CASEFLOW_API_HOST=127.0.0.1
CASEFLOW_API_PORT=8090
CASEFLOW_CORS_ORIGINS=http://localhost:5173
